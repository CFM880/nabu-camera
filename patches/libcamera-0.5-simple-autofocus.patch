+/*
+ * The simple IPA has no autofocus statistics of its own, so derive a contrast
+ * metric right after debayering: the mean absolute gradient of the green
+ * channel over the central half of the frame.  Every second pixel is sampled
+ * in both directions, which keeps the cost negligible next to the debayer.
+ */
+void DebayerCpu::updateFocusSharpness(const uint8_t *data)
+{
+	const unsigned int bpp = outputConfig_.bpp;
+	const unsigned int stride = outputConfig_.stride;
+	const unsigned int width = window_.width;
+	const unsigned int height = window_.height;
+	const unsigned int step = 2;
+	const unsigned int offset = bpp >= 3 ? 1 : 0;
+	const unsigned int x0 = std::max(width / 4, step);
+	const unsigned int x1 = width * 3 / 4;
+	const unsigned int y0 = height / 4;
+	const unsigned int y1 = height * 3 / 4;
+	const uint8_t *prev = nullptr;
+	uint64_t gradient = 0;
+	uint64_t level = 0;
+	unsigned int samples = 0;
+
+	focusSharpness_ = 0;
+
+	if (x1 <= x0 || y1 <= y0)
+		return;
+
+	for (unsigned int y = y0; y < y1; y += step) {
+		const uint8_t *row = data + y * stride;
+
+		if (prev) {
+			for (unsigned int x = x0; x < x1; x += step) {
+				const uint8_t v = row[x * bpp + offset];
+				const uint8_t p = prev[x * bpp + offset];
+				const uint8_t l = row[(x - step) * bpp + offset];
+
+				gradient += (v > p ? v - p : p - v) +
+					    (v > l ? v - l : l - v);
+				level += v;
+				samples++;
+			}
+		}
+
+		prev = row;
+	}
+
+	/*
+	 * Normalise by the mean green level so that exposure and gain changes
+	 * (the AGC is still settling during a scan) do not move the metric.
+	 * Q10 fixed point.
+	 */
+	if (samples && level)
+		focusSharpness_ = std::min<uint64_t>(gradient * 1024 / level,
+						     UINT32_MAX);
+}
