 void SoftwareIsp::queueRequest(const uint32_t frame, const ControlList &controls)
 {
+	if (lens_) {
+		const auto afMode = controls.get(controls::AfMode);
+		if (afMode.has_value()) {
+			switch (*afMode) {
+			case controls::AfModeManual:
+				af_.phase = AutoFocusState::Phase::Idle;
+				break;
+			case controls::AfModeAuto:
+				startAutoFocus(false);
+				break;
+			case controls::AfModeContinuous:
+				startAutoFocus(true);
+				break;
+			}
+		}
+
+		const auto afTrigger = controls.get(controls::AfTrigger);
+		if (afTrigger.has_value() && *afTrigger == controls::AfTriggerStart)
+			startAutoFocus(af_.continuous);
+	}
+
 	ipa_->queueRequest(frame, controls);
 }
 
+/**
+ * \brief Attach the lens used for autofocus
+ * \param[in] lens The camera lens
+ *
+ * When a lens is attached the software ISP keeps it focused with a contrast
+ * based autofocus loop, since the simple IPA has no lens control.
+ */
+void SoftwareIsp::setLens(CameraLens *lens)
+{
+	const ControlInfoMap &ctrls = lens->controls();
+	const auto it = ctrls.find(V4L2_CID_FOCUS_ABSOLUTE);
+	if (it == ctrls.end()) {
+		LOG(SoftwareIsp, Warning)
+			<< "Lens has no focus control, autofocus disabled";
+		return;
+	}
+
+	af_.minPos = it->second.min().get<int32_t>();
+	af_.maxPos = it->second.max().get<int32_t>();
+	lens_ = lens;
+
+	LOG(SoftwareIsp, Debug)
+		<< "Autofocus lens " << lens->model()
+		<< " focus range " << af_.minPos << "-" << af_.maxPos;
+}
+
+void SoftwareIsp::startAutoFocus(bool continuous)
+{
+	if (!lens_ || af_.maxPos <= af_.minPos)
+		return;
+
+	af_.phase = AutoFocusState::Phase::Coarse;
+	af_.continuous = continuous;
+	af_.pos = af_.minPos;
+	af_.bestPos = af_.pos;
+	af_.bestScore = 0;
+	af_.lowCount = 0;
+	af_.sampleCount = 0;
+	af_.settle = 3;
+	lens_->setFocusPosition(af_.pos);
+}
+
+static uint32_t median3(std::array<uint32_t, 3> &v)
+{
+	if (v[0] > v[1])
+		std::swap(v[0], v[1]);
+	if (v[1] > v[2])
+		std::swap(v[1], v[2]);
+	if (v[0] > v[1])
+		std::swap(v[0], v[1]);
+	return v[1];
+}
+
+void SoftwareIsp::runAutoFocus(uint32_t frame)
+{
+	const int32_t coarseStep = std::max(1, (af_.maxPos - af_.minPos) / 8);
+	const int32_t fineRange = std::max(2, coarseStep);
+	const int32_t fineStep = std::max(1, fineRange / 2);
+	constexpr unsigned int kSettle = 3;
+
+	if (af_.phase == AutoFocusState::Phase::Idle)
+		return;
+
+	/* Let the lens and the exposure settle after the last move. */
+	if (af_.settle) {
+		af_.settle--;
+		return;
+	}
+
+	uint32_t score = debayer_->focusSharpness();
+
+	if (af_.phase == AutoFocusState::Phase::Coarse ||
+	    af_.phase == AutoFocusState::Phase::Fine) {
+		/*
+		 * Average a few frames per position: exposure/gain noise moves
+		 * the metric by up to 3x from frame to frame, enough to pick
+		 * the wrong peak on a single sample.
+		 */
+		af_.samples[af_.sampleCount++] = score;
+		if (af_.sampleCount < af_.samples.size())
+			return;
+
+		score = median3(af_.samples);
+		af_.sampleCount = 0;
+
+		LOG(SoftwareIsp, Debug)
+			<< "Autofocus frame " << frame
+			<< " position " << af_.pos << " score " << score;
+	}
+
+	switch (af_.phase) {
+	case AutoFocusState::Phase::Coarse:
+		if (score > af_.bestScore) {
+			af_.bestScore = score;
+			af_.bestPos = af_.pos;
+		}
+
+		if (af_.pos + coarseStep <= af_.maxPos) {
+			af_.pos += coarseStep;
+			lens_->setFocusPosition(af_.pos);
+			af_.settle = kSettle;
+		} else {
+			/* Refine around the best coarse position. */
+			af_.fineLo = std::max(af_.minPos, af_.bestPos - fineRange);
+			af_.fineHi = std::min(af_.maxPos, af_.bestPos + fineRange);
+			af_.fineStep = fineStep;
+			af_.pos = af_.fineLo;
+			/* Keep the coarse best so a worse fine result cannot win. */
+			af_.settle = kSettle;
+			af_.phase = AutoFocusState::Phase::Fine;
+			lens_->setFocusPosition(af_.pos);
+		}
+		break;
+
+	case AutoFocusState::Phase::Fine:
+		if (score > af_.bestScore) {
+			af_.bestScore = score;
+			af_.bestPos = af_.pos;
+		}
+
+		if (af_.pos + af_.fineStep <= af_.fineHi) {
+			af_.pos += af_.fineStep;
+			lens_->setFocusPosition(af_.pos);
+			af_.settle = kSettle;
+		} else {
+			af_.pos = af_.bestPos;
+			af_.lockedScore = af_.bestScore;
+			af_.haveLock = true;
+			af_.lockedPos = af_.pos;
+			af_.settle = kSettle;
+			LOG(SoftwareIsp, Debug)
+				<< "Autofocus locked at " << af_.pos
+				<< " score " << af_.lockedScore;
+			af_.phase = af_.continuous
+					    ? AutoFocusState::Phase::Locked
+					    : AutoFocusState::Phase::Idle;
+			lens_->setFocusPosition(af_.pos);
+		}
+		break;
+
+	case AutoFocusState::Phase::Locked:
+		/* Track slowly and rescan when the scene loses sharpness. */
+		af_.lockedScore = (af_.lockedScore * 7 + score) / 8;
+		if (score * 10 < af_.lockedScore * 4)
+			af_.lowCount++;
+		else
+			af_.lowCount = 0;
+
+		if (af_.lowCount >= 20)
+			startAutoFocus(true);
+		break;
+
+	case AutoFocusState::Phase::Idle:
+		break;
+	}
+}
