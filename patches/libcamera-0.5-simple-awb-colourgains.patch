@@ -25,6 +25,33 @@ LOG_DEFINE_CATEGORY(IPASoftAwb)
 
 namespace ipa::soft::algorithms {
 
+/**
+ * \brief Load the optional per-CCT colour gain table
+ *
+ * With a colourGains table the grey-world estimate is only used to pick a
+ * colour temperature; the applied gains then come from the table.  A
+ * dominant-colour subject (a face filling the frame) no longer gets
+ * neutralised, while a neutral scene under a calibrated illuminant stays
+ * neutral.
+ */
+int Awb::init([[maybe_unused]] IPAContext &context, const YamlObject &tuningData)
+{
+	if (!tuningData.contains("colourGains"))
+		return 0;
+
+	int ret = grey_.init(tuningData);
+	if (ret) {
+		LOG(IPASoftAwb, Warning)
+			<< "Failed to parse 'colourGains', staying with grey world";
+		return 0;
+	}
+
+	hasColourGains_ = true;
+	LOG(IPASoftAwb, Info) << "AWB colour gain table in use";
+
+	return 0;
+}
+
 int Awb::configure(IPAContext &context,
 		   [[maybe_unused]] const IPAConfigInfo &configInfo)
 {
@@ -88,6 +115,20 @@ void Awb::process(IPAContext &context,
 	context.activeState.awb.temperatureK = estimateCCT(rgbGains);
 	metadata.set(controls::ColourTemperature, context.activeState.awb.temperatureK);
 
+	/*
+	 * With a colour gain table the grey-world gains above only served to
+	 * estimate the colour temperature; take the gains from the table.
+	 */
+	if (hasColourGains_) {
+		auto tuned = grey_.gainsFromColourTemperature(
+			context.activeState.awb.temperatureK);
+		if (tuned) {
+			gains.r() = tuned->r();
+			gains.g() = tuned->g();
+			gains.b() = tuned->b();
+		}
+	}
+
 	LOG(IPASoftAwb, Debug)
 		<< "gain R/B: " << gains << "; temperature: "
 		<< context.activeState.awb.temperatureK;
