+class CameraSensorHelperOv13b10 : public CameraSensorHelper
+{
+public:
+	CameraSensorHelperOv13b10()
+	{
+		/*
+		 * V4L2_CID_ANALOGUE_GAIN is exposed in 1/128 steps with 0x80
+		 * (128) as 1x.  The kernel driver writes the code to register
+		 * 0x3508 shifted left by one, so the resulting gain in real
+		 * units is still code/128.
+		 */
+		gain_ = AnalogueGainLinear{ 1, 0, 0, 128 };
+	}
+};
+REGISTER_CAMERA_SENSOR_HELPER("ov13b10", CameraSensorHelperOv13b10)
