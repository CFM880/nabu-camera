         highest_res_caps
     }
+
+    pub(crate) fn best_still_caps(&self) -> gst::Caps {
+        let size = self
+            .caps()
+            .as_ref()
+            .and_then(utils::caps::best_still_mode);
+
+        if let Some(utils::Size { width, height }) = size {
+            gst::Caps::builder("video/x-raw")
+                .field("width", width)
+                .field("height", height)
+                .build()
+        } else {
+            gst::Caps::builder("video/x-raw").build()
+        }
+    }
 }
