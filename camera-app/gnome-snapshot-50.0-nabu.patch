             .or(best_size_fallback)
     }
 
+    /// Selects the largest 4:3 mode for still capture.
+    ///
+    /// Camera sensors generally expose their full field of view in a 4:3
+    /// mode. If a device has no 4:3 mode, use its largest advertised mode.
+    pub(crate) fn best_still_mode(caps: &gst::Caps) -> Option<Size> {
+        let mut best_four_three: Option<Size> = None;
+        let mut best_any_ratio: Option<Size> = None;
+
+        for cap in caps.iter() {
+            let Ok(width) = cap.get::<i32>("width") else {
+                continue;
+            };
+            let Ok(height) = cap.get::<i32>("height") else {
+                continue;
+            };
+
+            let pixels = i64::from(width) * i64::from(height);
+            let is_larger = |current: &Option<Size>| {
+                current.as_ref().is_none_or(|size| {
+                    pixels > i64::from(size.width) * i64::from(size.height)
+                })
+            };
+
+            if is_larger(&best_any_ratio) {
+                best_any_ratio = Some(Size { width, height });
+            }
+
+            if i64::from(width) * 3 == i64::from(height) * 4
+                && is_larger(&best_four_three)
+            {
+                best_four_three = Some(Size { width, height });
+            }
+        }
+
+        best_four_three.or(best_any_ratio)
+    }
+
     fn best_resolution_for_fps(caps: &gst::Caps, framerate: gst::Fraction) -> gst::Caps {
         let fixed_caps = crate::SUPPORTED_ENCODINGS
             .iter()
@@ -435,4 +472,53 @@ mod tests {
             );
         }
     }
+
+    #[test]
+    fn test_best_still_mode() {
+        gst::init().expect("Failed to initialize gst");
+
+        let caps_with_four_three = [
+            gst_video::VideoCapsBuilder::new()
+                .width(4096)
+                .height(2160)
+                .build(),
+            gst_video::VideoCapsBuilder::new()
+                .width(3200)
+                .height(2400)
+                .build(),
+            gst_video::VideoCapsBuilder::new()
+                .width(1600)
+                .height(1200)
+                .build(),
+        ]
+        .into_iter()
+        .collect();
+        assert_eq!(
+            caps::best_still_mode(&caps_with_four_three),
+            Some(Size {
+                width: 3200,
+                height: 2400
+            })
+        );
+
+        let caps_without_four_three = [
+            gst_video::VideoCapsBuilder::new()
+                .width(2560)
+                .height(1080)
+                .build(),
+            gst_video::VideoCapsBuilder::new()
+                .width(3840)
+                .height(2160)
+                .build(),
+        ]
+        .into_iter()
+        .collect();
+        assert_eq!(
+            caps::best_still_mode(&caps_without_four_three),
+            Some(Size {
+                width: 3840,
+                height: 2160
+            })
+        );
+    }
 }
